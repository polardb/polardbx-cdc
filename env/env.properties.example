# PolarDB-X CDC local dev environment config
#
# Usage:
#   cp env.properties.example env.properties
#   Fill in the fields in [User Config] section
#
# Priority: System properties (-D) > env.properties > config.properties

# ============================================================
# [User Config] Fill in your dev environment info
# ============================================================

# MetaDB connection (URL must contain ?useSSL=false)
# Example: jdbc:mysql://127.0.0.1:4886/polardbx_meta_db?useSSL=false
metaDb_url=
metaDb_username=
metaDb_password=

# PolarDB-X (CN) connection (database must be __cdc__)
# Example: jdbc:mysql://127.0.0.1:9527/__cdc__?useSSL=false
polarx_url=
polarx_username=
polarx_password=

# Instance identity (from MetaDB inst_config table or remote dev machine)
polardbx_instance_id=
cluster_id=
